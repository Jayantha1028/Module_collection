global:
  scrape_interval: 15s
  evaluation_interval: 15s

scrape_configs:
  - job_name: "prometheus"
    static_configs:
      - targets: ["localhost:9090"]

  - job_name: "node-exporter"
    static_configs:
      - targets: ["${node_exporter_target}"]

%{ if length(scrape_targets) > 0 ~}
  - job_name: "extra-targets"
    static_configs:
      - targets:
%{ for target in scrape_targets ~}
          - "${target}"
%{ endfor ~}
%{ endif ~}
